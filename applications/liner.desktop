[Desktop Entry]
Type=Application
Name=Liner
Comment=Liner Music Player
Icon=__HOME__/.local/share/icons/MacOS-26-Glass-Clear/custom_overrides/audacious.png
TryExec=__HOME__/AppImages/liner.appimage
Exec=__HOME__/.local/opt/liner/AppRun --ozone-platform=x11 --enable-gpu-rasterization --ignore-gpu-blocklist --enable-zero-copy %U
Terminal=false
MimeType=x-scheme-handler/liner;
Categories=Audio;
StartupWMClass=liner
X-AppImage-Version=0.2.11
X-AppImage-Name=Liner
